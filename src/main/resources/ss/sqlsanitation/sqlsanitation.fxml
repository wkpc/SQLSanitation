<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="213.0" prefWidth="338.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="ss.sqlsanitation.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox alignment="CENTER" prefHeight="22.0" prefWidth="298.0">
      <children>
      
          <Label prefHeight="17.0" prefWidth="72.0" text="Username: " textAlignment="RIGHT" />
         <TextField fx:id="usernameField" />
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="24.0" prefWidth="298.0">
      <children>
         <Label prefHeight="17.0" prefWidth="72.0" text="Password: " textAlignment="RIGHT" />
         <TextField fx:id="passwordField" />
      </children>
   </HBox>
   <Button mnemonicParsing="false" onAction="#onLoginPressed" text="Login" />
</VBox>
